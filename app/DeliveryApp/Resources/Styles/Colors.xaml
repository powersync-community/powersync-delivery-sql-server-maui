<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="Primary">#512BD4</Color>
    <Color x:Key="ErrorColor">#C62828</Color>

    <Color x:Key="PageLight">#FFFFFF</Color>
    <Color x:Key="PageDark">#000000</Color>
    <Color x:Key="TextLight">#1C1C1E</Color>
    <Color x:Key="TextDark">#F2F2F7</Color>
    <Color x:Key="SecondaryTextLight">#6E6E73</Color>
    <Color x:Key="SecondaryTextDark">#98989F</Color>
    <Color x:Key="SeparatorLight">#E5E5EA</Color>
    <Color x:Key="SeparatorDark">#38383A</Color>

    <!-- Stop status badges (white text on these). -->
    <Color x:Key="StatusAssigned">#5B6B8C</Color>
    <Color x:Key="StatusDelivered">#2E7D32</Color>
    <Color x:Key="StatusFailed">#C77700</Color>
    <Color x:Key="StatusCanceled">#8E8E93</Color>

</ResourceDictionary>
